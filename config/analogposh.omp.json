{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "\ue285 ",
    "foreground": "#d6deeb",
    "background": "transparent"
  },
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\u256d\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": "\uf108 {{ .UserName }}@{{ .HostName }}",
          "foreground": "#000000",
          "background": "#02ffc4",
          "type": "session",
          "style": "diamond",
          "background_templates": [
            "{{ if .SSHSession }}#ff0289{{ else }}#02ffc4{{end}}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uf292 ",
          "foreground": "#ffeb95",
          "powerline_symbol": "\ue0b0",
          "background": "#ef5350",
          "type": "root",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": "\uf07c ",
            "folder_separator_icon": "<#011627>\ue0b1</> ",
            "home_icon": "\ueb06 ",
            "mapped_locations": {
              "/workspaces": "\uf4b0 ",
              "~/code": "\uf4b0 "
            },
            "style": "full",
            "windows_registry_icon": "\uf013"
          },
          "template": " {{ path .Path .Location }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#82AAFF",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "template": " {{ url .UpstreamIcon .UpstreamURL }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "foreground": "#011627",
          "powerline_symbol": "\ue0b0",
          "background": "#addb67",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e4cf6a{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f78c6c{{ end }}",
            "{{ if gt .Ahead 0 }}#C792EA{{ end }}",
            "{{ if gt .Behind 0 }}#c792ea{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " \uf313 {{ .Output }} ",
          "foreground": "#d6deeb",
          "powerline_symbol": "\ue0b0",
          "background": "#234d70",
          "type": "command",
          "style": "powerline",
          "command": "fleet-status",
          "background_templates": [
            "{{ if contains \"~\" .Output }}#e4cf6a{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "roundrock",
            "threshold": 0
          },
          "leading_diamond": "<transparent,#575656>\ue0b0</>",
          "trailing_diamond": "\ue0b4",
          "template": " {{ .FormattedMs }}",
          "foreground": "#d6deeb",
          "background": "#575656",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "<transparent,#d6deeb>\ue0b2</>",
          "template": "\uf489  {{ .Name }} ",
          "foreground": "#011627",
          "background": "#d6deeb",
          "type": "shell",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,background>\ue0b2",
          "foreground": "#ffffff",
          "background": "#8f43f3",
          "type": "battery",
          "style": "diamond",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if eq \"Discharging\" .State.String}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}"
          ],
          "templates": [
            "{{ if eq \"Charging\" .State.String }} \udb80\udc84 {{ else if gt .Percentage 90 }} \udb80\udc82 {{ else if gt .Percentage 80 }} \udb80\udc81 {{ else if gt .Percentage 70 }} \udb80\udc80 {{ else if gt .Percentage 60 }} \udb80\udc7f {{ else if gt .Percentage 50 }} \udb80\udc7e  {{ else if gt .Percentage 40 }} \udb80\udc7d {{ else if gt .Percentage 30 }} \udb80\udc7c {{ else if gt .Percentage 20 }} \udb80\udc7b {{ else if gt .Percentage 10 }} \udb80\udc7a {{ else }} \udb80\udc8e {{ end }}",
            "{{ .Percentage }}% "
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "<transparent,#8f43f3>\ue0b2</>",
          "template": "\ue266 {{ round .PhysicalPercentUsed .Precision }}% ",
          "foreground": "#ffffff",
          "background": "#8f43f3",
          "type": "sysinfo",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05"
          },
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b4",
          "template": "\ue641 {{ .CurrentDate | date .Format }}",
          "foreground": "#d6deeb",
          "background": "#234d70",
          "type": "time",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\u2570",
          "foreground": "#21c7a8",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "\ue285",
          "foreground": "#22da6e",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
