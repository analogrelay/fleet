{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/all",
      "enabled": true
    },
    "github_readonly": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/x/all/readonly",
      "enabled": true
    },
    "azure_devops": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "azure-sdk"
      ],
      "enabled": true
    }
  },
  "tools": {
    "github_*": false,
    "github_readonly_*": false,
    "azure_devops_*": false
  },
  "agent": {
    "build": {
      "tools": {
        "github_readonly_*": true,
        "azure_devops_*": true
      }
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  }
}
