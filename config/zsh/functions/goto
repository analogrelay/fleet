target=$1

orgs=$(find $HOME/code -maxdepth 1 -mindepth 1 -type d)

github_repos=$(echo $orgs | grep "^$HOME/code/[^@]*$" | xargs -I ORG find "ORG" -maxdepth 1 -mindepth 1 -type d)
ado_repos=$(echo $orgs | grep "^$HOME/code/[^@]*@[^@]*$" | xargs -I ORG find "ORG" -maxdepth 2 -mindepth 2 -type d)

# Collect all the candidates
candidates=$(cat <<EOF
$github_repos
$ado_repos
EOF
)

if [ "$CODESPACES" = "true" ]; then
    workspaces=$(find /workspaces -maxdepth 1 -mindepth 1 -type d -not -name '.*')
    candidates=$(cat <<EOF
$workspaces
EOF
)
fi

if [ "$(uname)" = "Darwin" ]; then
    candidates=$(cat <<EOF
$candidates
$HOME/Downloads
$HOME/Desktop
$HOME/Documents
EOF
)

fi

candidates=$(cat <<EOF
$candidates
$HOME/kb
$HOME/code
EOF
)

# Some useful aliases
goto_aliases=(
)

for goto_alias in "${(k)goto_aliases}"; do
    candidates=$(cat <<EOF
$candidates
$goto_alias
EOF
)
done

if [ "$DEBUG" = "1" ]; then
    echo "Orgs: $orgs"
    echo "Github Repos: $github_repos"
    echo "ADO Repos: $ado_repos"
    echo "Candidates: $candidates"
else
    qry_arg=()
    if [ -n "$1" ]; then
        qry_arg=("--query" "$1" "--select-1" "--exit-0")
    fi
    target=$(echo "$candidates" | fzf ${qry_arg[@]})
    if [ $? != 0 ]; then
        echo "failed to find target to goto" 1>&2
        return
    else
        if [ -n "${aliases[$target]}" ]; then
            target=${aliases[$target]}
        fi
        cd $target
    fi
fi
