#!/usr/bin/env bash
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
dotfiles_root="$(dirname $(dirname $(dirname $script_dir)))"
cd "$dotfiles_root"
source ./machines/hosts/common/_utils.sh

# Configuration for a codespace
echo "Configuring Codespace dotfiles..."

./machines/hosts/common/configure --package-manager brew

make_link "$dotfiles_root/zsh" "$HOME/.config/zsh"
make_link "$dotfiles_root/home/analogposh.omp.json" "$HOME/.config/analogposh.omp.json"
make_link "$dotfiles_root/git" "$HOME/.config/git/config.d"
make_link "$dotfiles_root/eza" "$HOME/.config/eza"

# Source '.config/zsh/.zshrc' from our ~/.zshrc
# It's OK to replace whatever default zshrc existed. We're not worried about what came before.
echo 'source $HOME/.config/zsh/.zshrc' > ~/.zshrc

# Generate the appropriate config imports
git config set --global "include.path" "~/.config/git/config.d/base.gitconfig"

if type -p zsh >/dev/null; then
  echo "Setting zsh as default shell..."
  sudo chsh -s "$(which zsh)" "$(whoami)"
fi

git config set --global "include.path" "~/.config/git/config.d/codespaces.gitconfig"
