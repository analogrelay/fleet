#!/usr/bin/env bash
#/ Usage: bootstrap [--home <config>] [<hostname>]
#/ Bootstrap a Unix system with Nix and the fleet configuration.
#/
#/ Can be run standalone:
#/   curl -fsSL <raw-url>/script/bootstrap | bash -s -- [hostname]
#/   curl -fsSL <raw-url>/script/bootstrap | bash -s -- --home ashley@codespace
#/
#/ Or from a local clone:
#/   script/bootstrap [hostname]
#/   script/bootstrap --home ashley@linux-workstation
#/
#/ OPTIONS
#/   --home <config>  Bootstrap home-manager only (no sudo required).
#/                    Config is a homeConfigurations attribute name
#/                    (e.g. ashley@linux-workstation).
#/
#/ ENVIRONMENT DETECTION
#/   In a GitHub Codespace, automatically uses --home $USER@codespace.
#/
#/ ARGUMENTS
#/   <hostname>  The hostname of the NixOS/Darwin configuration to use.
#/               Defaults to the current machine's hostname.
#/               Ignored when --home is used.
set -euo pipefail

FLEET_REPO="https://github.com/analogrelay/fleet.git"
FLEET_DIR="$HOME/.config/fleet"

# --- Helpers ---

log() { echo "==> $*"; }
err() { echo "ERROR: $*" >&2; exit 1; }

# --- Parse arguments ---

home_config=""
target_hostname=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --home)
      shift
      home_config="${1:-}"
      [ -z "$home_config" ] && err "--home requires a configuration name (e.g. ashley@linux-workstation)"
      shift
      ;;
    -h|--help)
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    *)
      target_hostname="$1"
      shift
      ;;
  esac
done

if [ -z "$home_config" ] && [ -z "$target_hostname" ]; then
  # Autodetect GitHub Codespaces
  if [ "${CODESPACES:-}" = "true" ]; then
    home_config="${USER}@codespace"
    log "Detected GitHub Codespace, using home configuration: $home_config"
  else
    target_hostname="$(hostname)"
  fi
fi

if [ -n "$home_config" ]; then
  log "Home-manager configuration: $home_config"
else
  log "Target hostname: $target_hostname"
fi

# --- Install Nix ---

if command -v nix >/dev/null 2>&1; then
  log "Nix is already installed, skipping."
else
  # Use single-user install if we don't have root access
  install_args=""
  if [ -n "$home_config" ] && ! sudo -n true 2>/dev/null; then
    log "Installing Nix via Determinate Systems installer (single-user, no root)..."
    install_args="--single-user"
  else
    log "Installing Nix via Determinate Systems installer..."
  fi
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install $install_args

  # Source nix-daemon so nix is available in this shell
  if [ -e "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh" ]; then
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  elif [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  fi

  command -v nix >/dev/null 2>&1 || err "Nix installation failed — 'nix' not found on PATH."
fi

# --- Clone or locate fleet repo ---

# If we're already inside the fleet repo, use it
if [ -f "flake.nix" ] && grep -q 'NixOS Configurations' flake.nix 2>/dev/null; then
  FLEET_DIR="$(pwd)"
  log "Running from existing fleet repo at $FLEET_DIR"
elif [ -d "$FLEET_DIR/.git" ]; then
  log "Fleet repo already exists at $FLEET_DIR, pulling latest..."
  nix-shell -p git --run "git -C '$FLEET_DIR' pull --ff-only" || true
else
  log "Cloning fleet repo to $FLEET_DIR..."
  mkdir -p "$(dirname "$FLEET_DIR")"
  nix-shell -p git --run "git clone '$FLEET_REPO' '$FLEET_DIR'"
fi

# --- Validate config exists ---

if [ -n "$home_config" ]; then
  log "Validating homeConfigurations.$home_config exists..."
  if ! nix eval "$FLEET_DIR#homeConfigurations.\"$home_config\"" --apply 'x: true' >/dev/null 2>&1; then
    echo ""
    err "No home configuration found for '$home_config'.
Available homeConfigurations:
$(nix eval "$FLEET_DIR#homeConfigurations" --apply 'x: builtins.concatStringsSep "\n" (map (n: "  - " + n) (builtins.attrNames x))' --raw 2>/dev/null || echo "  (unable to list)")"
  fi
  log "Found home configuration '$home_config'"
else
  if [ ! -d "$FLEET_DIR/machines/hosts/$target_hostname" ]; then
    echo ""
    err "No configuration found for hostname '$target_hostname'.
Available hosts:
$(ls -1 "$FLEET_DIR/machines/hosts/" | grep -v '^common$' | sed 's/^/  - /')"
  fi
  log "Found configuration for '$target_hostname'"
fi

# --- Run rebuild ---

export FLEET_ROOT="$FLEET_DIR"
cd "$FLEET_DIR"

if [ -n "$home_config" ]; then
  log "Running script/rebuild --home $home_config..."
  exec script/rebuild --home "$home_config"
else
  log "Running script/rebuild $target_hostname..."
  exec script/rebuild "$target_hostname"
fi