#!/usr/bin/env bash
#/ Usage: bootstrap [--home <config>] [<identity>]
#/ Bootstrap a Unix system with Nix and the fleet configuration.
#/
#/ Can be run standalone:
#/   curl -fsSL <raw-url>/script/bootstrap | bash -s -- [identity]
#/   curl -fsSL <raw-url>/script/bootstrap | bash -s -- --home ashley@devcontainer
#/
#/ Or from a local clone:
#/   script/bootstrap [identity]
#/   script/bootstrap --home ashley@linux-workstation
#/
#/ OPTIONS
#/   --home <config>  Bootstrap home-manager only (no sudo required).
#/                    Config is a homeConfigurations attribute name
#/                    (e.g. ashley@linux-workstation).
#/   --no-systemd     Install Nix in single-user mode (no daemon, no systemd).
#/                    Useful in containers or environments without systemd.
#/   --no-confirm     Accepted for backward compatibility (bootstrap always
#/                    skips the rebuild confirmation prompt).
#/
#/ ENVIRONMENT DETECTION
#/   In a GitHub Codespace or dev container, automatically uses --home $USER@devcontainer.
#/
#/ ARGUMENTS
#/   <identity>  The fleet identity for this machine, in [user@]identity format.
#/               Defaults to hostname (or 'devcontainer' in GitHub Codespaces).
#/               Written to ~/.local/share/fleet/identity for future rebuilds.
set -euo pipefail

FLEET_REPO="https://github.com/analogrelay/fleet.git"
FLEET_DIR="$HOME/.config/fleet"

# --- Helpers ---

log() { echo "==> $*"; }
err() { echo "ERROR: $*" >&2; exit 1; }

# --- Parse arguments ---

home_config=""
config_name=""
identity=""
no_systemd=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --home)
      shift
      home_config="${1:-}"
      [ -z "$home_config" ] && err "--home requires a configuration name (e.g. ashley@linux-workstation)"
      shift
      ;;
    --no-systemd)
      no_systemd=true
      shift
      ;;
    --no-confirm)
      # Accepted for backward compatibility; bootstrap always skips
      # the rebuild confirmation prompt.
      shift
      ;;
    -h|--help)
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    *)
      config_name="$1"
      shift
      ;;
  esac
done

if [ -n "$config_name" ]; then
  # Positional arg provided: extract identity from [user@]identity format
  identity="${config_name#*@}"
elif [ -z "$home_config" ]; then
  # No args at all: auto-detect
  if [ "${CODESPACES:-}" = "true" ]; then
    home_config="${USER}@devcontainer"
    identity="devcontainer"
    log "Detected GitHub Codespace, using identity: $identity"
  else
    identity="$(hostname)"
  fi
else
  # --home provided but no positional arg: extract identity from home_config
  identity="${home_config#*@}"
fi

IDENTITY_FILE="$HOME/.local/share/fleet/identity"
install -dm 0700 "$(dirname "$IDENTITY_FILE")"
printf '%s' "$identity" > "$IDENTITY_FILE"
log "Fleet identity: $identity"

if [ -n "$home_config" ]; then
  log "Home-manager configuration: $home_config"
fi

# --- Install Nix ---

if command -v nix >/dev/null 2>&1; then
  log "Nix is already installed, skipping."
else
  # Use single-user install if we don't have root access or are in a container
  install_args=""
  if $no_systemd; then
    log "Installing Nix via Determinate Systems installer (single-user, no systemd)..."
		install_args=("--init=none")
  elif [ -n "$home_config" ] && ! sudo -n true 2>/dev/null; then
    log "Installing Nix via Determinate Systems installer (single-user, no root)..."
		install_args=("--init=none")
  else
		log "Installing Nix via Determinate Systems installer (multi-user, using systemd)..."
  fi

  # The Determinate installer requires root. If we're not root, use sudo.
  if [ "$(id -u)" -ne 0 ]; then
    log "sudo is required to install Nix; you may see a password prompt."
    curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sudo sh -s -- install linux --no-confirm ${install_args[@]+"${install_args[@]}"}
  else
    curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install linux --no-confirm ${install_args[@]+"${install_args[@]}"}
  fi

  # For non-root single-user installs, chown /nix to the current user so
  # nix commands work without root.
  if [ "$(id -u)" -ne 0 ] && [[ " ${install_args[*]+"${install_args[*]}"} " == *"--init=none"* ]]; then
    log "Changing ownership of /nix to $(whoami)..."
    sudo chown -R "$(id -u):$(id -g)" /nix
  fi

  # Source nix-daemon so nix is available in this shell
  if [ -e "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh" ]; then
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  elif [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  fi

  command -v nix >/dev/null 2>&1 || err "Nix installation failed — 'nix' not found on PATH."
fi

# --- Clone or locate fleet repo ---

# If we're already inside the fleet repo, use it
if [ -f "flake.nix" ] && grep -q 'NixOS Configurations' flake.nix 2>/dev/null; then
  FLEET_DIR="$(pwd)"
  log "Running from existing fleet repo at $FLEET_DIR"
elif [ -d "$FLEET_DIR/.git" ]; then
  log "Fleet repo already exists at $FLEET_DIR, pulling latest..."
  nix-shell -p git --run "git -C '$FLEET_DIR' pull --ff-only" || true
else
  log "Cloning fleet repo to $FLEET_DIR..."
  mkdir -p "$(dirname "$FLEET_DIR")"
  nix-shell -p git --run "git clone '$FLEET_REPO' '$FLEET_DIR'"
fi

# --- Detect system architecture ---

arch="$(uname -m)"
case "$arch" in
  x86_64)  arch="x86_64" ;;
  aarch64|arm64) arch="aarch64" ;;
  *) log "Warning: Unknown architecture '$arch'" ;;
esac
if [ "$(uname)" = "Darwin" ]; then
  nix_system="${arch}-darwin"
else
  nix_system="${arch}-linux"
fi
log "Detected system: $nix_system"

# --- Validate config exists ---

if [ -n "$home_config" ]; then
  log "Validating homeConfigurations.$home_config.$nix_system exists..."
  if ! nix eval "$FLEET_DIR#homeConfigurations.\"$home_config\".\"$nix_system\"" --apply 'x: true' >/dev/null 2>&1; then
    echo ""
    err "No home configuration found for '$home_config' on system '$nix_system'.
Available homeConfigurations:
$(nix eval "$FLEET_DIR#homeConfigurations" --apply 'x: builtins.concatStringsSep "\n" (map (n: "  - " + n) (builtins.attrNames x))' --raw 2>/dev/null || echo "  (unable to list)")"
  fi
  log "Found home configuration '$home_config' for $nix_system"
else
  if [ ! -d "$FLEET_DIR/machines/hosts/$identity" ]; then
    echo ""
    err "No configuration found for identity '$identity'.
Available hosts:
$(ls -1 "$FLEET_DIR/machines/hosts/" | grep -v '^common$' | sed 's/^/  - /')"
  fi
  log "Found configuration for '$identity'"
fi

# --- Run rebuild ---

export FLEET_ROOT="$FLEET_DIR"
cd "$FLEET_DIR"

rebuild_flags=(--no-confirm)

if [ -n "$home_config" ]; then
  log "Running script/rebuild --home $home_config ${rebuild_flags[*]+"${rebuild_flags[*]}"}..."
  exec script/rebuild --home "$home_config" "${rebuild_flags[@]}"
else
  log "Running script/rebuild $identity ${rebuild_flags[*]+"${rebuild_flags[*]}"}..."
  exec script/rebuild "$identity" "${rebuild_flags[@]}"
fi
