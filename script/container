#!/usr/bin/env bash
#/ Usage: script/container [OPTIONS] [IMAGE]
#/ Start a dev container, mount the fleet repo, and bootstrap home-manager.
#/
#/ The container runs detached with tini (via --init) and sleep infinity.
#/ After bootstrapping, the container name is printed to stdout.
#/ Attach with: docker exec -it <name> zsh
#/
#/ OPTIONS
#/   -h, --help    Display this help message.
#/   -n, --name    Container name (default: Docker auto-generated).
#/
#/ ARGUMENTS
#/   IMAGE   Base image to use (default: alpine).
set -euo pipefail

# --- Helpers ---

log() { echo "==> $*" >&2; }
err() { echo "ERROR: $*" >&2; exit 1; }

# --- Parse arguments ---

base_image="alpine"
container_name=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    -n|--name)
      shift
      container_name="${1:-}"
      [ -z "$container_name" ] && err "--name requires a value"
      shift
      ;;
    *)
      base_image="$1"
      shift
      ;;
  esac
done

name_args=()
if [ -n "$container_name" ]; then
  name_args=(--name "$container_name")
fi

# --- Locate fleet repo ---

script_dir="$(cd "$(dirname "$0")" && pwd)"
fleet_dir="$(dirname "$script_dir")"

if [ ! -f "$fleet_dir/flake.nix" ]; then
  err "Cannot find fleet repo. Run this script from within the fleet repository."
fi

log "Base image: $base_image"

# --- Start container ---

log "Starting container..."
container_name=$(docker run -d \
  --init \
  "${name_args[@]}" \
  -v "$fleet_dir:/home/ashley/.config/fleet:ro" \
  "$base_image" \
  sleep infinity)

log "Container started: $container_name"

# --- Install prerequisites ---

log "Installing prerequisites..."

# Detect package manager and install dependencies
docker exec "$container_name" sh -c '
  if command -v apk >/dev/null 2>&1; then
    apk add --no-cache bash curl git sudo xz shadow
  elif command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq && apt-get install -y -qq bash curl git sudo xz-utils >/dev/null
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y -q bash curl git sudo xz
  elif command -v yum >/dev/null 2>&1; then
    yum install -y -q bash curl git sudo xz
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm bash curl git sudo xz
  else
    echo "WARNING: Unknown package manager, skipping prerequisite install" >&2
  fi
'

# --- Create ashley user if it doesn't exist ---

docker exec "$container_name" sh -c '
  if ! id ashley >/dev/null 2>&1; then
    if command -v adduser >/dev/null 2>&1 && [ -f /etc/alpine-release ]; then
      adduser -D -s /bin/bash ashley
    else
      useradd -m -s /bin/bash ashley
    fi
    echo "ashley ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ashley
  fi
'

# --- Bootstrap home-manager ---

log "Bootstrapping home-manager configuration..."
docker exec -u ashley "$container_name" \
  bash -c 'cd ~/.config/fleet && script/bootstrap --no-systemd --home ashley@devcontainer'

log "Bootstrap complete."

# Print the container name to stdout
echo "$container_name"
