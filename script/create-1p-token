#!/usr/bin/env bash
#/ Usage: script/create-1p-token [--force]
#/ Create a 1Password service account token for this fleet host.
#/
#/ OPTIONS
#/   --force    Overwrite existing token without prompting.
#/   -h, --help Show this help message.
#/
#/ PREREQUISITES
#/   - Sign in as an admin user: eval $(op signin)
#/   - Fleet identity must exist: ~/.local/share/fleet/identity
set -eo pipefail

CRED_FILE="/etc/credstore.encrypted/fleet-1p-token"
OP_TOKEN_FILE="/etc/fleet/1p-token"
IDENTITY_FILE="$HOME/.local/share/fleet/identity"

# Parse arguments
force=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --force)
      force=true
      ;;
    -h|--help)
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      grep '^#/' "$0" | cut -c4-
      exit 1
      ;;
  esac
  shift
done

# Verify admin sign-in
whoami_output=$(op whoami 2>&1) || {
  echo "Error: Not signed in to 1Password CLI." >&2
  echo "Run: eval \$(op signin)" >&2
  exit 1
}
if echo "$whoami_output" | grep -qi "service account"; then
  echo "Error: Signed in as a service account, not a human user." >&2
  echo "Run: eval \$(op signin) to sign in with your personal account." >&2
  exit 1
fi

# Read fleet identity
if [ ! -f "$IDENTITY_FILE" ]; then
  echo "Error: Fleet identity not found at $IDENTITY_FILE." >&2
  echo "Run bootstrap to set the identity first." >&2
  exit 1
fi
raw_identity=$(cat "$IDENTITY_FILE")

# Strip user@ prefix — keep only the machine part
identity="${raw_identity#*@}"

# Check for existing token
has_existing=false
if [ "$(uname)" = "Darwin" ]; then
  if security find-generic-password -s "fleet" -a "1p-service-account" -w >/dev/null 2>&1; then
    has_existing=true
  fi
elif [ -f "$CRED_FILE" ] || [ -f "$OP_TOKEN_FILE" ]; then
  has_existing=true
fi

if $has_existing && ! $force; then
  if [ "$(uname)" = "Darwin" ]; then
    printf "Token already exists in macOS Keychain. Overwrite? [y/N] "
  elif [ -f "$CRED_FILE" ]; then
    printf "Token already exists at %s (systemd-creds). Overwrite? [y/N] " "$CRED_FILE"
  else
    printf "Token already exists at %s. Overwrite? [y/N] " "$OP_TOKEN_FILE"
  fi
  read -r answer
  case "$answer" in
    [yY]|[yY][eE][sS]) ;;
    *)
      echo "Aborted."
      exit 0
      ;;
  esac
fi

# Create service account
echo "Creating 1Password service account: fleet-${identity}"
token=$(op service-account create --raw "fleet-${identity}" --vault Fleet:read_items)

if [ -z "$token" ]; then
  echo "Error: No token returned from op service-account create." >&2
  exit 1
fi

# Save token
if [ "$(uname)" = "Darwin" ]; then
  # Store in macOS Keychain (matches fleet.secrets provision-secrets lookup)
  security delete-generic-password -s "fleet" -a "1p-service-account" >/dev/null 2>&1 || true
  security add-generic-password -s "fleet" -a "1p-service-account" -w "$token"
  echo "Token saved to macOS Keychain (service: fleet, account: 1p-service-account)"
elif command -v systemd-creds >/dev/null 2>&1; then
  # Encrypt with systemd-creds (sealed to this machine's host key)
  sudo mkdir -p "$(dirname "$CRED_FILE")"
  printf '%s' "$token" | sudo systemd-creds encrypt --name=fleet-1p-token - "$CRED_FILE"
  echo "Token saved to $CRED_FILE (systemd-creds encrypted)"
  echo "Note: rebuild to activate LoadCredentialEncrypted in the service unit."
else
  # Fall back to root-only plain file
  sudo mkdir -p "$(dirname "$OP_TOKEN_FILE")"
  printf '%s' "$token" | sudo tee "$OP_TOKEN_FILE" >/dev/null
  sudo chmod 0400 "$OP_TOKEN_FILE"
  sudo chown root:root "$OP_TOKEN_FILE"
  echo "Token saved to $OP_TOKEN_FILE (root-only file)"
fi
