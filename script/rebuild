#!/usr/bin/env bash
#/ Usage: script/rebuild [<name>] [--home] [--test] [--dry-run] [--show-trace]
#/ Rebuild the current system using the latest configuration.
#/
#/ OPTIONS
#/   -h, --help         Display this help message.
#/   --home             Use home-manager only (no sudo required).
#/   --test             Run a 'nixos-rebuild test' instead of a 'nixos-rebuild switch'.
#/   --dry-run          Conduct a dry run and don't actually modify anything.
#/   --show-trace       Show a trace whenever there's a Nix error.
#/   --update           Update the flake lockfile before rebuilding.
#/   --non-interactive  Skip prompts (passed to refresh-secrets).
#/
#/ ARGUMENTS
#/   <name>       The configuration name.
#/                  System mode: hostname (default: `hostname`).
#/                  Home mode: homeConfigurations attribute (e.g. ashley@linux-workstation).
# Resolve the absolute path of this script's directory.
script_dir=$(dirname $(readlink -f $0))
repo_root=$(dirname $script_dir)

# This script is designed to not require the nix shell.

set -eo pipefail

if [ "$(uname)" = "Linux" ]; then
  platform=$(cat /etc/os-release | grep '^ID=' | cut -d'=' -f2)
else
  platform=$(uname)
fi

# Parse arguments
config_name=""
nixos_rebuild_command="switch"
rebuild_args=()
update=false
home_only=false
non_interactive=false
while [[ $# -gt 0 ]]; do
  key="$1"
  shift
  case "$key" in
    --home)
      home_only=true
      ;;
    --test)
      nixos_rebuild_command="test"
      ;;
    --dry-run|--show-trace)
      rebuild_args+=($key)
      ;;
    --install-bootloader)
      if [ "$platform" == "nixos" ]; then
        rebuild_args+=("--install-bootloader")
      fi
      ;;
    -h|--help)
      # Print usage information
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    --update)
      update=true
      ;;
    --non-interactive)
      non_interactive=true
      ;;
    *)
      config_name="$key"
      ;;
  esac
done

# Determine the hostname for secret loading.
# For --home mode use the current system hostname; secrets are per-host not per-config.
if $home_only; then
  effective_hostname=$(hostname)
else
  effective_hostname="${config_name:-$(hostname)}"
fi

# Refresh secrets from 1Password (writes .secrets.nix if token is available).
# If no token is found and running non-interactively, this is a no-op.
"$script_dir/refresh-secrets" \
  ${non_interactive:+--non-interactive} \
  "$effective_hostname"

if $home_only; then
  if [ -z "$config_name" ]; then
    echo "Error: --home requires a configuration name (e.g. ashley@linux-workstation)."
    echo "Available homeConfigurations:"
    nix eval "$repo_root#homeConfigurations" --apply 'x: builtins.attrNames x' 2>/dev/null || echo "  (unable to list)"
    exit 1
  fi

  echo "Rebuilding home configuration: $config_name"
  echo "Continue? [y/N]"
  read -r answer
  if [ "$answer" != "y" ]; then
    echo "Aborting"
    exit 1
  fi

  if $update; then
    echo "Updating flake lockfile"
    nix flake update
  fi

  # Use nix run to invoke home-manager so it doesn't need to be pre-installed
  nix run "$repo_root#homeConfigurations.\"$config_name\".activationPackage" "${rebuild_args[@]}"
else
  if [ -z "$config_name" ]; then
    config_name=$(hostname)
  fi

  echo "Rebuilding system from configuration for $config_name"
  echo "Continue? [y/N]"
  read -r answer
  if [ "$answer" != "y" ]; then
    echo "Aborting"
    exit 1
  fi

  if $update; then
    echo "Updating flake lockfile"
    nix flake update
  fi

  if [ "$(uname)" = "Darwin" ]; then
    if [ "$nixos_rebuild_command" = "test" ]; then
      echo "Running 'nixos-rebuild test' on macOS is not supported."
      exit 1
    fi
    echo "You may be prompted for your sudo password to run the rebuild script."
    sudo darwin-rebuild switch "${rebuild_args[@]}" --flake "$repo_root#$config_name"
  else
    echo "You may be prompted for your sudo password to run the rebuild script."
    sudo nixos-rebuild switch "${rebuild_args[@]}" --flake "$repo_root#$config_name"
  fi
fi
