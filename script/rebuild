#!/usr/bin/env bash
#/ Usage: script/rebuild [<name>] [--home] [--test] [--dry-run] [--show-trace]
#/ Rebuild the current system using the latest configuration.
#/
#/ OPTIONS
#/   -h, --help         Display this help message.
#/   --home             Use home-manager only (no sudo required).
#/   --test             Run a 'nixos-rebuild test' instead of a 'nixos-rebuild switch'.
#/   --dry-run          Conduct a dry run and don't actually modify anything.
#/   --show-trace       Show a trace whenever there's a Nix error.
#/   --update           Update the flake lockfile before rebuilding.
#/   --no-confirm       Skip the confirmation prompt before rebuilding.
#/
#/ ARGUMENTS
#/   <name>       The configuration name, in [user@]identity format.
#/                  System mode: identity (read from ~/.local/share/fleet/identity if omitted).
#/                  Home mode:   homeConfigurations attribute (e.g. ashley@devcontainer).
# Resolve the absolute path of this script's directory.
script_dir=$(dirname $(readlink -f $0))
repo_root=$(dirname $script_dir)

# This script is designed to not require the nix shell.

set -eo pipefail

if [ "$(uname)" = "Linux" ]; then
  platform=$(cat /etc/os-release | grep '^ID=' | cut -d'=' -f2)
else
  platform=$(uname)
fi

# Detect system architecture for home-manager configuration resolution
arch="$(uname -m)"
case "$arch" in
  x86_64)  arch="x86_64" ;;
  aarch64|arm64) arch="aarch64" ;;
  *) echo "Warning: Unknown architecture '$arch'" >&2 ;;
esac
if [ "$(uname)" = "Darwin" ]; then
  nix_system="${arch}-darwin"
else
  nix_system="${arch}-linux"
fi

# Parse arguments
config_name=""
nixos_rebuild_command="switch"
rebuild_args=()
update=false
home_only=false
no_confirm=false
while [[ $# -gt 0 ]]; do
  key="$1"
  shift
  case "$key" in
    --home)
      home_only=true
      ;;
    --test)
      nixos_rebuild_command="test"
      ;;
    --dry-run|--show-trace)
      rebuild_args+=($key)
      ;;
    --install-bootloader)
      if [ "$platform" == "nixos" ]; then
        rebuild_args+=("--install-bootloader")
      fi
      ;;
    -h|--help)
      # Print usage information
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    --update)
      update=true
      ;;
    --no-confirm)
      no_confirm=true
      ;;
    *)
      config_name="$key"
      ;;
  esac
done

IDENTITY_FILE="$HOME/.local/share/fleet/identity"

# Identity is extracted from config_name if provided (works for both
# "sephiroth" and "ashley@devcontainer" formats).
# For system mode only: fall back to the identity file, then error.
if [ -n "$config_name" ]; then
  identity="${config_name#*@}"
elif ! $home_only && [ -f "$IDENTITY_FILE" ]; then
  identity=$(cat "$IDENTITY_FILE")
  config_name="$identity"
elif ! $home_only; then
  echo "Error: No fleet identity found."
  echo "Run 'script/bootstrap' to set up your fleet identity,"
  echo "or pass the identity explicitly: script/rebuild <identity>"
  exit 1
fi
# Home mode without config_name is caught below by the existing
# "--home requires a configuration name" check.

if $home_only; then
  if [ -z "$config_name" ]; then
    echo "Error: --home requires a configuration name (e.g. ashley@linux-workstation)."
    echo "Available homeConfigurations:"
    nix eval "$repo_root#homeConfigurations" --apply 'x: builtins.attrNames x' 2>/dev/null || echo "  (unable to list)"
    exit 1
  fi

  echo "Rebuilding home configuration: $config_name"
  if ! $no_confirm; then
    echo "Continue? [y/N]"
    read -r answer
    if [ "$answer" != "y" ]; then
      echo "Aborting"
      exit 1
    fi
  fi

  if $update; then
    echo "Updating flake lockfile"
    nix flake update
  fi

  # Use nix run to invoke home-manager so it doesn't need to be pre-installed
  nix run --no-write-lock-file "$repo_root#homeConfigurations.\"$config_name\".\"$nix_system\".activationPackage" "${rebuild_args[@]}"
else
  echo "Rebuilding system from configuration for $config_name"
  if ! $no_confirm; then
    echo "Continue? [y/N]"
    read -r answer
    if [ "$answer" != "y" ]; then
      echo "Aborting"
      exit 1
    fi
  fi

  if $update; then
    echo "Updating flake lockfile"
    nix flake update
  fi

  # Detect dirty tree before activation (uncommitted changes affect the build).
  _activated_dirty=false
  if ! git -C "$repo_root" diff --quiet HEAD 2>/dev/null || \
     ! git -C "$repo_root" diff --cached --quiet 2>/dev/null; then
    _activated_dirty=true
  fi

  if [ "$(uname)" = "Darwin" ]; then
    if [ "$nixos_rebuild_command" = "test" ]; then
      echo "Running 'nixos-rebuild test' on macOS is not supported."
      exit 1
    fi
    echo "You may be prompted for your sudo password to run the rebuild script."
    if command -v darwin-rebuild >/dev/null 2>&1; then
      sudo darwin-rebuild switch "${rebuild_args[@]}" --flake "$repo_root#$config_name"
    else
      # darwin-rebuild is not yet on PATH (first activation); use nix run to
      # bootstrap nix-darwin. nix-darwin's switch command invokes sudo itself
      # for the parts that require root, so no sudo wrapper is needed here.
      echo "darwin-rebuild not found; performing initial nix-darwin activation via nix run..."
      sudo nix --extra-experimental-features "nix-command flakes" run "github:LnL7/nix-darwin/nix-darwin-25.11" -- switch "${rebuild_args[@]}" --flake "$repo_root#$config_name"
    fi
    mkdir -p "$HOME/.local/state/fleet"
    git -C "$repo_root" rev-parse HEAD > "$HOME/.local/state/fleet/activated_commit"
    echo "$_activated_dirty"        > "$HOME/.local/state/fleet/activated_dirty"
  else
    echo "You may be prompted for your sudo password to run the rebuild script."
    sudo nixos-rebuild switch "${rebuild_args[@]}" --flake "$repo_root#$config_name"
    mkdir -p "$HOME/.local/state/fleet"
    git -C "$repo_root" rev-parse HEAD > "$HOME/.local/state/fleet/activated_commit"
    echo "$_activated_dirty"        > "$HOME/.local/state/fleet/activated_dirty"
  fi
fi
