#!/usr/bin/env bash
#/ Usage: script/refresh-secrets [--non-interactive] [<hostname>]
#/ Load secrets from 1Password and write them to .secrets.nix in the fleet repo.
#/
#/ OPTIONS
#/   --non-interactive  Skip prompts; no-op if no token is saved.
#/   -h, --help         Display this help message.
#/
#/ ARGUMENTS
#/   <hostname>  Hostname to load secrets for (default: current hostname).
#/
#/ The service account token is stored at ~/.local/share/fleet/op-token (0600).
#/ If no token is present and running interactively, the user is prompted to
#/ create and paste one. If no token is available, the script exits without
#/ modifying .secrets.nix (leaving any existing file intact).
script_dir=$(dirname $(readlink -f $0))
repo_root=$(dirname $script_dir)

set -eo pipefail

OP_TOKEN_FILE="$HOME/.local/share/fleet/op-token"
SECRETS_NIX="$repo_root/.secrets.nix"

# Parse arguments
non_interactive=false
hostname=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --non-interactive)
      non_interactive=true
      ;;
    -h|--help)
      grep '^#/' "$0" | cut -c4-
      exit 0
      ;;
    *)
      hostname="$1"
      ;;
  esac
  shift
done
[ -z "$hostname" ] && hostname=$(hostname)

load_op_token() {
  if [ -f "$OP_TOKEN_FILE" ]; then
    OP_SERVICE_ACCOUNT_TOKEN=$(cat "$OP_TOKEN_FILE")
    export OP_SERVICE_ACCOUNT_TOKEN
    return 0
  fi

  if $non_interactive; then
    return 1
  fi

  echo ""
  echo "No 1Password service account token found."
  echo "To create one, run:"
  echo "  op service-account create fleet-${hostname} --vault Fleet:read_items"
  echo ""
  printf "Paste the service account token (or press Enter to skip): "
  read -r -s token_input
  echo ""

  if [ -z "$token_input" ]; then
    echo "Skipping 1Password secrets."
    return 1
  fi

  install -dm 0700 "$(dirname "$OP_TOKEN_FILE")"
  printf '%s' "$token_input" > "$OP_TOKEN_FILE"
  chmod 0600 "$OP_TOKEN_FILE"
  echo "Token saved to $OP_TOKEN_FILE"

  OP_SERVICE_ACCOUNT_TOKEN="$token_input"
  export OP_SERVICE_ACCOUNT_TOKEN
  return 0
}

fetch_secrets() {
  echo "Fetching secrets from 1Password for host: $hostname"

  local tmp
  tmp=$(mktemp "${SECRETS_NIX}.XXXXXX")
  chmod 0600 "$tmp"

  # Use nix shell to provide op and jq without requiring pre-install.
  # OP_SERVICE_ACCOUNT_TOKEN is already exported and will be inherited.
	export NIXPKGS_ALLOW_UNFREE=1 
  nix shell --impure 'nixpkgs#_1password-cli' 'nixpkgs#jq' --command bash -euc '
    items_json=$(op item list \
      --tags "host-'"$hostname"'" \
      --vault Fleet \
      --format json 2>/dev/null) || { printf "{ }\n" > "'"$tmp"'"; exit 0; }

    item_ids=$(echo "$items_json" | jq -r ".[].id")
    if [ -z "$item_ids" ]; then
      printf "{ }\n" > "'"$tmp"'"
      exit 0
    fi

    secrets_json=$(echo "$item_ids" | while IFS= read -r item_id; do
      op item get "$item_id" --vault Fleet --format json 2>/dev/null
    done | jq -sc "
      map({
        key: .title,
        value: (
          .fields
          | map(select((.type == \"CONCEALED\" or .type == \"STRING\") and .value != null))
          | map({ key: .label, value: .value })
          | from_entries
        )
      }) | from_entries
    ")

    # Emit valid Nix syntax. Quoted-string keys and string values are
    # syntactically identical between Nix and JSON, so jq can generate .nix.
    echo "$secrets_json" | jq -r "
      \"{\n\" + (to_entries | map(
        \"  \" + (.key | tojson) + \" = {\n\" +
        (.value | to_entries | map(
          \"    \" + (.key | tojson) + \" = \" + (.value | tojson) + \";\"
        ) | join(\"\n\")) +
        \"\n  };\"
      ) | join(\"\n\")) + \"\n}\"
    " > "'"$tmp"'"
  ' && mv "$tmp" "$SECRETS_NIX" || {
    rm -f "$tmp"
    echo "Warning: Failed to fetch secrets. Leaving existing .secrets.nix intact."
    return 1
  }

  echo "Secrets written to $SECRETS_NIX"
}

if load_op_token; then
  fetch_secrets
else
  echo "No token available; .secrets.nix unchanged."
fi
